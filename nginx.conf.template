server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Docker's DNS. With proxy_pass going through a variable the backend is
    # looked up per request, not once at start: nginx starts before the backend
    # exists (a separate compose project can't depends_on it) and follows it to
    # a new IP after a redeploy instead of 502-ing until this container restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        try_files $uri $uri/ /index.html;
        # index.html names the current bundle; a cached one after a deploy
        # points at files that are gone and the dashboard loads blank.
        add_header Cache-Control "no-cache";
    }

    # Vite puts a content hash in every file name here, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ ^/(auth|v1|admin|health|docs|redoc|openapi.json) {
        set $backend http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
